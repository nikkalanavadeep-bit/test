# ==============================================================================
# Gemini Chatbot - Backend Environment Variables Template
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Database Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: For automated migrations via 'npm run db:migrate'
# Obtain from: Supabase Dashboard -> Database -> Database Settings -> Connection String
SUPABASE_DB_PASSWORD=your_database_password_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
