# ==============================================================================
# Git Ignore Configuration - Gemini AI Chatbot
# ==============================================================================

# --------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# --------------------------------------------------
.env
.env.*
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing template files
!.env.example
!backend/.env.example
!frontend/.env.example

# --------------------------------------------------
# Dependencies
# --------------------------------------------------
node_modules/
*/node_modules/
.pnpm-store/

# --------------------------------------------------
# Logs & Debugging
# --------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------
# Build Artifacts & Caches
# --------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/

# --------------------------------------------------
# OS & System Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --------------------------------------------------
# IDE & Code Editors
# --------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --------------------------------------------------
# Temporary & Diagnostic Files
# --------------------------------------------------
tmp/
temp/
scratch/
coverage/
.nyc_output/
